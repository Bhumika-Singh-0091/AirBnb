# Secret used to sign login tokens (change this!)
SECRET=change_me_to_a_long_random_string
# SQLite file (created automatically)
DATABASE_URL=sqlite:///./wandernest.db
# Optional: Mapbox token for geocoding. Falls back to free OpenStreetMap Nominatim, then default coords.
MAP_TOKEN=
# Where the Next.js app runs (for CORS)
FRONTEND_ORIGIN=http://localhost:3000
# Set true when serving over HTTPS
COOKIE_SECURE=false
